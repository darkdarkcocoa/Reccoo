<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Version>2.2.0</Version>
    <AssemblyName>CocoaRecorder</AssemblyName>
    <AssemblyTitle>Cocoa Recorder</AssemblyTitle>
    <Product>Cocoa Recorder</Product>
    <Description>A cozy pixel-art system audio recorder for Windows.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\PixelifySans.ttf" />
    <Resource Include="Fonts\neodgm.ttf" />
    <Resource Include="Fonts\SUIT-Regular.ttf" />
    <Resource Include="Fonts\SUIT-SemiBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- Countdown meows, CC0. The closing ticks 3→2→1 play meow-1→2→3; meow-4/5 alternate on earlier ticks. -->
    <Resource Include="Sounds\meow-1.mp3" />
    <Resource Include="Sounds\meow-2.mp3" />
    <Resource Include="Sounds\meow-3.mp3" />
    <Resource Include="Sounds\meow-4.mp3" />
    <Resource Include="Sounds\meow-5.mp3" />
  </ItemGroup>

</Project>
