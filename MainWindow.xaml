<Window x:Class="CocoaRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CocoaRecorder"
        mc:Ignorable="d"
        Title="Cocoa Recorder"
        Width="1216" Height="852"
        MinWidth="1080" MinHeight="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- ===== Outer window shell — pixel border + 6px offset shadow ===== -->
    <Grid Margin="6">
        <!-- Drop shadow (offset down) -->
        <Rectangle Fill="{StaticResource InkDarkBrush}" Margin="0,6,0,0"/>

        <!-- Window body -->
        <Border x:Name="WindowBody"
                BorderBrush="{StaticResource InkDarkBrush}"
                BorderThickness="3"
                Background="{StaticResource CreamBrush}"
                Margin="0,0,0,6"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ============== Title bar ============== -->
                <Border Grid.Row="0"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource InkDarkBrush}"
                        BorderThickness="0,0,0,3"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- top highlight stripe -->
                        <Rectangle Grid.ColumnSpan="3" Fill="#80FFFFFF" Height="2" VerticalAlignment="Top"/>
                        <!-- bottom deep stripe (inside the bar above the 3px ink border) -->
                        <Rectangle Grid.ColumnSpan="3" Fill="{StaticResource AccentDeepBrush}" Height="3" VerticalAlignment="Bottom"/>

                        <!-- left game-boy speaker dots -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Border Width="10" Height="10" Background="{StaticResource InkDarkBrush}" Margin="0,0,4,0">
                                <Border Background="{StaticResource AccentSoftBrush}" Margin="2"/>
                            </Border>
                            <Border Width="10" Height="10" Background="{StaticResource InkDarkBrush}" Margin="0,0,4,0">
                                <Border Background="{StaticResource AccentSoftBrush}" Margin="2"/>
                            </Border>
                            <Border Width="10" Height="10" Background="{StaticResource InkDarkBrush}">
                                <Border Background="{StaticResource AccentSoftBrush}" Margin="2"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource L_WindowTitle}"
                                   Foreground="{StaticResource InkDarkBrush}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="20,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <RadioButton x:Name="KorToggle" Style="{StaticResource TitleLangToggle}" Content="KOR" Width="40" GroupName="UiLang" Checked="LangToggle_Checked" ToolTip="한국어"/>
                            <RadioButton x:Name="EnToggle" Style="{StaticResource TitleLangToggle}" Content="EN" Width="34" GroupName="UiLang" Checked="LangToggle_Checked" Margin="-2,0,10,0" ToolTip="English"/>
                            <Button Style="{StaticResource TitleBarButton}" Content="_" Click="Minimize_Click" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource TitleBarButton}" Content="▢" Click="Maximize_Click" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource TitleCloseButton}" Content="✕" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============== Main body (cream + dot pattern) ============== -->
                <Grid Grid.Row="1" Background="{StaticResource CreamBrush}">
                    <Grid Margin="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="378"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*" MinHeight="180"/>
                        </Grid.RowDefinitions>

                        <!-- ====================================================
                             MAIN STAGE — timer + waveform + transport
                             ==================================================== -->
                        <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource PixelPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- status strip -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource InkDarkBrush}"
                                        BorderThickness="0,0,0,2"
                                        Padding="18,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                x:Name="StatusDot"
                                                Width="16" Height="16"
                                                Background="{StaticResource InkSoftBrush}"
                                                BorderBrush="{StaticResource InkDarkBrush}"
                                                BorderThickness="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="StatusDotScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   x:Name="StatusLabel"
                                                   Text="{DynamicResource L_StatusIdle}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkDarkBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   x:Name="FormatInfoText"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Big timer -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <TextBlock x:Name="TimerMin" Text="00"
                                               FontFamily="{StaticResource PixelMonoFont}"
                                               FontWeight="Bold" FontSize="84"
                                               Foreground="{StaticResource InkDarkBrush}"
                                               LineHeight="84"
                                               TextOptions.TextFormattingMode="Ideal"/>
                                    <TextBlock x:Name="TimerColon" Text=":"
                                               FontFamily="{StaticResource PixelMonoFont}"
                                               FontWeight="Bold" FontSize="64"
                                               Foreground="{StaticResource AccentDeepBrush}"
                                               Margin="2,8,2,0"/>
                                    <TextBlock x:Name="TimerSec" Text="00"
                                               FontFamily="{StaticResource PixelMonoFont}"
                                               FontWeight="Bold" FontSize="84"
                                               Foreground="{StaticResource InkDarkBrush}"
                                               LineHeight="84"
                                               TextOptions.TextFormattingMode="Ideal"/>
                                    <TextBlock x:Name="TimerCs" Text=".00"
                                               FontFamily="{StaticResource PixelMonoFont}"
                                               FontWeight="Bold" FontSize="32"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               VerticalAlignment="Bottom"
                                               Margin="6,0,0,8"/>
                                </StackPanel>

                                <!-- Waveform host -->
                                <Grid Grid.Row="2" Margin="18,8,18,4" VerticalAlignment="Center">
                                    <ItemsControl x:Name="WaveformHost"
                                                  Height="120"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                    <Rectangle Width="8"
                                                               Height="{Binding Height}"
                                                               Fill="{Binding Fill}"
                                                               VerticalAlignment="Bottom"
                                                               SnapsToDevicePixels="True"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- Transport buttons -->
                                <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,8,0,14">
                                <StackPanel x:Name="TransportButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="RecordButton"
                                            Style="{StaticResource PixelButton}"
                                            Background="{StaticResource AccentBrush}"
                                            BorderBrush="{StaticResource AccentDeepBrush}"
                                            MinWidth="220" Height="64"
                                            Click="RecordButton_Click"
                                            Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="RecordButtonDot"
                                                     Width="20" Height="20"
                                                     Fill="{StaticResource AccentDeepBrush}"
                                                     Stroke="{StaticResource InkDarkBrush}"
                                                     StrokeThickness="2"
                                                     Margin="0,0,12,0"/>
                                            <TextBlock x:Name="RecordButtonText"
                                                       Text="{DynamicResource L_RecordStart}"
                                                       FontSize="20"
                                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PauseButton"
                                            Style="{StaticResource PixelButton}"
                                            Background="{StaticResource LilacBrush}"
                                            BorderBrush="{StaticResource LilacDeepBrush}"
                                            MinWidth="140" Height="64"
                                            IsEnabled="False"
                                            Visibility="Collapsed"
                                            Click="PauseButton_Click"
                                            Margin="0,0,12,0">
                                        <Grid>
                                            <StackPanel x:Name="PauseIconGroup" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                                    <Border Width="5" Height="20" Background="{StaticResource InkDarkBrush}" Margin="0,0,4,0" SnapsToDevicePixels="True"/>
                                                    <Border Width="5" Height="20" Background="{StaticResource InkDarkBrush}" SnapsToDevicePixels="True"/>
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource L_PauseBtn}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel x:Name="ResumeIconGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Path Data="M 0 0 L 12 8 L 0 16 Z"
                                                      Fill="{StaticResource InkDarkBrush}"
                                                      Width="12" Height="16"
                                                      Stretch="Uniform"
                                                      Margin="0,0,12,0"/>
                                                <TextBlock Text="{DynamicResource L_ResumeBtn}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="StopButton"
                                            Style="{StaticResource PixelButton}"
                                            Background="{StaticResource PaperBrush}"
                                            BorderBrush="{StaticResource CreamDeepBrush}"
                                            MinWidth="150" Height="64"
                                            IsEnabled="False"
                                            Click="StopButton_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="18"
                                                    Background="{StaticResource InkSoftBrush}"
                                                    BorderBrush="{StaticResource InkDarkBrush}"
                                                    BorderThickness="2"
                                                    Margin="0,0,12,0"/>
                                            <TextBlock Text="{DynamicResource L_StopBtn}" FontSize="20" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <!-- 카운트다운 선택은 녹음 버튼 왼쪽 모서리에, 힌트는 오른쪽 끝에 붙는다.
                                     라벨 길이가 달라지는 두 언어에서 같은 자리를 유지하기 위한 배치다. -->
                                <Grid Margin="0,12,0,0"
                                      Width="{Binding ActualWidth, ElementName=TransportButtons}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                ToolTip="{DynamicResource L_CountdownHint}"
                                                ToolTipService.ShowOnDisabled="True">
                                        <Button x:Name="CountdownDownButton"
                                                Style="{StaticResource CountdownStepButton}"
                                                Click="CountdownDown_Click">
                                            <Border Width="12" Height="3"
                                                    Background="{StaticResource InkDarkBrush}"
                                                    SnapsToDevicePixels="True"/>
                                        </Button>
                                        <Border x:Name="CountdownValueBox"
                                                MinWidth="66" Height="30"
                                                BorderBrush="{StaticResource InkDarkBrush}"
                                                BorderThickness="2"
                                                Margin="4,0"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Rectangle Fill="#80FFFFFF" Height="2" VerticalAlignment="Top"/>
                                                <Rectangle x:Name="CountdownValueStripe" Height="3" VerticalAlignment="Bottom"/>
                                                <TextBlock x:Name="CountdownValueText"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="CountdownUpButton"
                                                Style="{StaticResource CountdownStepButton}"
                                                Click="CountdownUp_Click">
                                            <Grid Width="12" Height="12">
                                                <Border Width="12" Height="3"
                                                        Background="{StaticResource InkDarkBrush}"
                                                        VerticalAlignment="Center"
                                                        SnapsToDevicePixels="True"/>
                                                <Border Width="3" Height="12"
                                                        Background="{StaticResource InkDarkBrush}"
                                                        HorizontalAlignment="Center"
                                                        SnapsToDevicePixels="True"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource L_ShortcutHint}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource InkSoftBrush}"/>
                                </Grid>
                                </StackPanel>
                            </Grid>
                        </ContentControl>

                        <!-- ====================================================
                             RIGHT COLUMN — settings + mascot
                             ==================================================== -->
                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="200"/>
                            </Grid.RowDefinitions>

                            <!-- Settings panel -->
                            <ContentControl Grid.Row="0" Style="{StaticResource PixelPanel}">
                                <StackPanel Margin="16">
                                    <TextBlock Text="{DynamicResource L_SettingsTitle}"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource InkDarkBrush}"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="{DynamicResource L_InputDevice}"
                                               FontSize="13"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="DeviceCombo"
                                              Style="{StaticResource PixelComboBox}"
                                              DisplayMemberPath="FriendlyName"
                                              Margin="0,0,0,12"/>

                                    <TextBlock Text="{DynamicResource L_OutputFormat}"
                                               FontSize="13"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="WavToggle"
                                                     Style="{StaticResource FormatToggle}"
                                                     IsChecked="True"
                                                     GroupName="Format"
                                                     Checked="Format_Checked">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- mini LP disc -->
                                                <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                    <Ellipse Width="14" Height="14" Fill="{StaticResource InkDarkBrush}"/>
                                                    <Ellipse Width="4" Height="4" Fill="{StaticResource PaperBrush}"/>
                                                </Grid>
                                                <TextBlock Text="WAV"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Grid.Column="1"
                                                     x:Name="Mp3Toggle"
                                                     Style="{StaticResource FormatToggle}"
                                                     GroupName="Format"
                                                     Checked="Format_Checked"
                                                     Margin="-2,0,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- mini cassette -->
                                                <Border Width="18" Height="12"
                                                        Background="{StaticResource InkDarkBrush}"
                                                        BorderBrush="{StaticResource InkDarkBrush}"
                                                        BorderThickness="2"
                                                        Margin="0,0,6,0"
                                                        SnapsToDevicePixels="True">
                                                    <Border Background="{StaticResource PaperBrush}"
                                                            Width="12" Height="3"
                                                            VerticalAlignment="Center"
                                                            SnapsToDevicePixels="True"/>
                                                </Border>
                                                <TextBlock Text="MP3"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <TextBlock x:Name="BitrateLabel"
                                               Text="{DynamicResource L_Mp3Quality}"
                                               FontSize="12"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Margin="0,0,0,4"
                                               Visibility="Collapsed"/>
                                    <Grid x:Name="BitrateGroup"
                                          Margin="0,0,0,12"
                                          Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0"
                                                     x:Name="LoToggle"
                                                     Style="{StaticResource FormatToggle}"
                                                     Content="LO"
                                                     GroupName="Bitrate"
                                                     Checked="Bitrate_Checked"/>
                                        <RadioButton Grid.Column="1"
                                                     x:Name="MedToggle"
                                                     Style="{StaticResource FormatToggle}"
                                                     Content="MED"
                                                     IsChecked="True"
                                                     GroupName="Bitrate"
                                                     Checked="Bitrate_Checked"
                                                     Margin="-2,0,0,0"/>
                                        <RadioButton Grid.Column="2"
                                                     x:Name="HiToggle"
                                                     Style="{StaticResource FormatToggle}"
                                                     Content="HI"
                                                     GroupName="Bitrate"
                                                     Checked="Bitrate_Checked"
                                                     Margin="-2,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{DynamicResource L_InputLevel}"
                                               FontSize="13"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Margin="0,0,0,6"/>
                                    <Border Background="{StaticResource CreamBrush}"
                                            BorderBrush="{StaticResource InkDarkBrush}"
                                            BorderThickness="2"
                                            Padding="3"
                                            SnapsToDevicePixels="True">
                                        <ItemsControl x:Name="LevelMeter" Height="14">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Rectangle Fill="{Binding Fill}" Margin="1,0" SnapsToDevicePixels="True"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock Text="{DynamicResource L_SaveFolder}"
                                               FontSize="13"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               Margin="0,12,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{StaticResource PaperBrush}"
                                                BorderBrush="{StaticResource InkDarkBrush}"
                                                BorderThickness="2"
                                                Padding="10,6"
                                                Margin="0,0,6,0"
                                                SnapsToDevicePixels="True">
                                            <TextBlock x:Name="FolderText"
                                                       Text="..."
                                                       FontSize="13"
                                                       Foreground="{StaticResource InkDarkBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PixelButton}"
                                                Background="{StaticResource MintBrush}"
                                                BorderBrush="{StaticResource MintDeepBrush}"
                                                Height="34"
                                                Padding="14,0"
                                                FontSize="13"
                                                Content="{DynamicResource L_ChangeBtn}"
                                                Click="ChangeFolder_Click"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>

                            <!-- Mascot card -->
                            <ContentControl Grid.Row="2" Style="{StaticResource PixelPanel}"
                                            Background="{StaticResource AccentSoftBrush}">
                                <Grid Margin="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Text="{DynamicResource L_MascotName}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkDarkBrush}"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="♥  ★"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentDeepBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Mascot canvas (filled at runtime) -->
                                        <Canvas Grid.Column="0"
                                                x:Name="MascotCanvas"
                                                Width="96" Height="112"
                                                Margin="0,0,12,0"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True"
                                                RenderTransformOrigin="0.5,1">
                                            <Canvas.RenderTransform>
                                                <TranslateTransform x:Name="MascotBob" Y="0"/>
                                            </Canvas.RenderTransform>
                                        </Canvas>
                                        <!-- speech bubble (tail + bubble) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Polygon Points="0,8 8,0 8,16"
                                                     Fill="{StaticResource PaperBrush}"
                                                     Stroke="{StaticResource InkDarkBrush}"
                                                     StrokeThickness="2"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,-2,0"
                                                     SnapsToDevicePixels="True"/>
                                            <Border Background="{StaticResource PaperBrush}"
                                                    BorderBrush="{StaticResource InkDarkBrush}"
                                                    BorderThickness="2"
                                                    Padding="10,8"
                                                    VerticalAlignment="Center"
                                                    SnapsToDevicePixels="True">
                                                <TextBlock x:Name="MascotSpeech"
                                                           Text="{DynamicResource L_Hello}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource InkDarkBrush}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="18"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ContentControl>
                        </Grid>

                        <!-- ====================================================
                             BOTTOM — recordings library
                             ==================================================== -->
                        <ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                        Style="{StaticResource PixelPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- header -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource CreamBrush}"
                                        BorderBrush="{StaticResource InkDarkBrush}"
                                        BorderThickness="0,0,0,2"
                                        Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="📁"
                                                   FontSize="18"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource L_LibraryTitle}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource InkDarkBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   x:Name="RecordingCountText"
                                                   Text=""
                                                   FontSize="13"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   x:Name="LibraryFolderHint"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <!-- list -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="12">
                                    <ItemsControl x:Name="RecordingsList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PaperBrush}"
                                                        BorderBrush="{StaticResource InkDarkBrush}"
                                                        BorderThickness="2"
                                                        Padding="10"
                                                        Margin="6"
                                                        SnapsToDevicePixels="True"
                                                        MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                                        MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                                        MouseMove="Card_MouseMove"
                                                        ToolTip="{DynamicResource L_CardTooltip}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- pixel cassette icon -->
                                                        <Border Grid.Column="0"
                                                                Width="48" Height="32"
                                                                Background="{Binding TapeColor}"
                                                                BorderBrush="{StaticResource InkDarkBrush}"
                                                                BorderThickness="2"
                                                                Margin="0,0,12,0"
                                                                SnapsToDevicePixels="True">
                                                            <Grid>
                                                                <Border Background="{StaticResource PaperBrush}"
                                                                        Width="36" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        SnapsToDevicePixels="True"/>
                                                                <StackPanel Orientation="Horizontal"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                    <Ellipse Width="6" Height="6"
                                                                             Fill="{StaticResource InkDarkBrush}"
                                                                             Margin="0,0,8,0"/>
                                                                    <Ellipse Width="6" Height="6"
                                                                             Fill="{StaticResource InkDarkBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <Grid MouseLeftButtonDown="RecordingName_DoubleClick">
                                                                <TextBlock x:Name="NameLabel"
                                                                           Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource InkDarkBrush}"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBox x:Name="NameEdit"
                                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontSize="14"
                                                                         FontWeight="Bold"
                                                                         Foreground="{StaticResource InkDarkBrush}"
                                                                         Background="{StaticResource PaperBrush}"
                                                                         BorderBrush="{StaticResource InkDarkBrush}"
                                                                         BorderThickness="2"
                                                                         Padding="4,2"
                                                                         Visibility="Collapsed"
                                                                         KeyDown="RenameBox_KeyDown"
                                                                         LostKeyboardFocus="RenameBox_LostFocus"
                                                                         Loaded="RenameBox_Loaded"
                                                                         IsVisibleChanged="RenameBox_VisibleChanged">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Meta}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource InkSoftBrush}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Button x:Name="PlayBtn"
                                                                Grid.Column="2"
                                                                Style="{StaticResource PixelIconButton}"
                                                                Background="{StaticResource AccentBrush}"
                                                                BorderBrush="{StaticResource AccentDeepBrush}"
                                                                Tag="{Binding Path}"
                                                                Click="PlayRecording_Click"
                                                                Margin="6,0">
                                                            <Grid>
                                                                <Path x:Name="PlayGlyph"
                                                                      Data="M 0 0 L 8 6 L 0 12 Z"
                                                                      Fill="{StaticResource InkDarkBrush}"
                                                                      Width="8" Height="12"
                                                                      Stretch="Uniform"/>
                                                                <StackPanel x:Name="PauseGlyph" Orientation="Horizontal" Visibility="Collapsed">
                                                                    <Border Width="3" Height="12" Background="{StaticResource InkDarkBrush}" Margin="0,0,2,0" SnapsToDevicePixels="True"/>
                                                                    <Border Width="3" Height="12" Background="{StaticResource InkDarkBrush}" SnapsToDevicePixels="True"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource PixelIconButton}"
                                                                Tag="{Binding Path}"
                                                                Click="DeleteRecording_Click">
                                                            <TextBlock Text="✕"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource InkSoftBrush}"/>
                                                        </Button>
                                                        </Grid>
                                                        <!-- Progress bar (visible only while this item is playing) -->
                                                        <Border Grid.Row="1"
                                                                Height="8"
                                                                Margin="0,8,0,0"
                                                                Background="{StaticResource CreamBrush}"
                                                                BorderBrush="{StaticResource InkDarkBrush}"
                                                                BorderThickness="2"
                                                                ClipToBounds="True"
                                                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"
                                                                SnapsToDevicePixels="True">
                                                            <Border Background="{StaticResource MintDeepBrush}"
                                                                    HorizontalAlignment="Stretch"
                                                                    RenderTransformOrigin="0,0"
                                                                    SnapsToDevicePixels="True">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding Progress}"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="PauseGlyph" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Empty state -->
                                <StackPanel Grid.Row="1"
                                            x:Name="EmptyStateText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Visible">
                                    <!-- pixel empty cassette -->
                                    <Border Width="96" Height="64"
                                            Background="{StaticResource CreamDeepBrush}"
                                            BorderBrush="{StaticResource InkSoftBrush}"
                                            BorderThickness="3"
                                            HorizontalAlignment="Center"
                                            SnapsToDevicePixels="True"
                                            Opacity="0.7">
                                        <Grid>
                                            <Border Background="{StaticResource PaperBrush}"
                                                    Width="72" Height="28"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{StaticResource InkSoftBrush}"
                                                    BorderThickness="2"
                                                    SnapsToDevicePixels="True"/>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{StaticResource InkSoftBrush}"
                                                         Margin="0,0,16,0"/>
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{StaticResource InkSoftBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{DynamicResource L_EmptyTitle}"
                                               FontSize="13"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,2"/>
                                    <TextBlock Text="{DynamicResource L_EmptyHint}"
                                               FontSize="12"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.7"/>
                                </StackPanel>
                            </Grid>
                        </ContentControl>

                        <!-- corner sparkles -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="★"
                                   FontSize="16"
                                   Foreground="{StaticResource GoldDeepBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Margin="-6,-6,0,0"
                                   Opacity="0.7"
                                   IsHitTestVisible="False"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="♥"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentDeepBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Margin="0,-6,-6,0"
                                   Opacity="0.7"
                                   IsHitTestVisible="False"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="♪"
                                   FontSize="16"
                                   Foreground="{StaticResource LilacDeepBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                   Margin="-6,0,0,-6"
                                   Opacity="0.7"
                                   IsHitTestVisible="False"/>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
